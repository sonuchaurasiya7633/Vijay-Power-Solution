# VIJOY POWER SOLUTION — Environment Variables

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database (MongoDB Atlas or Local MongoDB)
MONGODB_URI="mongodb://127.0.0.1:27017/vijoy_power_solution"

# Authentication & Sessions
# Generate secure key using: openssl rand -base64 32
JWT_SECRET="vps_solar_ultra_secure_jwt_secret_key_minimum_32_chars_2026"
SESSION_EXPIRY_DAYS="7"

# Initial Super Admin Bootstrap (Run: npm run seed)
SUPER_ADMIN_NAME="Super Administrator"
SUPER_ADMIN_EMAIL="admin@vijoypowersolution.com"
SUPER_ADMIN_PASSWORD="Admin@VPS2026SolarSecure!"

# Cloudinary Media Configuration
CLOUDINARY_CLOUD_NAME="demo-vps"
CLOUDINARY_API_KEY="123456789012345"
CLOUDINARY_API_SECRET="abcdefghijklmnopqrstuvwxyz12"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="demo-vps"

# Nodemailer / Transactional Email Notifications
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="notifications@vijoypowersolution.com"
SMTP_PASS="smtp_password_here"
SMTP_FROM="VIJOY POWER SOLUTION <notifications@vijoypowersolution.com>"
ADMIN_NOTIFICATION_EMAIL="contact@vijoypowersolution.com"

# Business Contact Defaults
NEXT_PUBLIC_COMPANY_NAME="VIJOY POWER SOLUTION"
NEXT_PUBLIC_COMPANY_PHONE="+91 94310 00000"
NEXT_PUBLIC_WHATSAPP_PHONE="919431000000"
NEXT_PUBLIC_COMPANY_EMAIL="contact@vijoypowersolution.com"
